hello @Sami Davor Aissaoui @Haythem this is the env file for the resmo workspace
# ================================
# RESMO MONOREPO - SHARED ENV
# ================================
# This file is loaded by all apps in the monorepo
# App-specific overrides can be placed in apps/<app>/.env.local

# ================================
# Server Configuration
# ================================
PORT=3000
NODE_ENV=development

# ================================
# MongoDB Configuration
# ================================
MONGODB_URI=mongodb+srv://resmo:7vHZZrDzeOkT6cXF@resmo.qhrpclo.mongodb.net/resmo?retryWrites=true&w=majority&appName=resmo
ENABLE_PROPERTY_WATCHER=true

# ================================
# JWT Configuration
# ================================
JWT_SECRET=resmo-dev-secret-key-2024
JWT_EXPIRES_IN=7d

# ================================
# CORS Configuration
# ================================
CORS_ORIGIN=*

# ================================
# Google OAuth (optional)
# ================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ================================
# Email Configuration (SMTP)
# ================================
SMTP_HOST=mx4125.usc1.mymailhosting.com
SMTP_PORT=587
SMTP_USER=no-reply@korpor.com
SMTP_PASS=Korpor.31
SMTP_FROM=no-reply@korpor.com

# ================================
# Frontend URLs (for CORS & redirects)
# ================================
VITE_API_URL=http://localhost:3000
# Optional: origin for QR/track links (https://api.yourdomain.com). If unset, derived from VITE_API_URL.
# VITE_PUBLIC_API_ORIGIN=
VITE_ADMIN_URL=http://localhost:5173
VITE_COMPANY_URL=http://localhost:5174
VITE_SUPERADMIN_URL=http://localhost:5175
VITE_CONSEILLER_URL=http://localhost:5176
# Backend: base URL for growth QR redirects when target is a path (e.g. /property/123)
COMPANY_FRONTEND_URL=http://localhost:5174

# ================================
# Clerk Authentication
# ================================
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key-here

# ================================
# Meta (Facebook/Instagram) Ads & Social Media
# ================================
# Centralized Model: Uses Business Manager System User Token
# Companies grant partner access to their Pages/IG/Ad Accounts via Business Manager
# Get these from https://business.facebook.com/

# Meta Ads API (shared credentials)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-access-token
META_AD_ACCOUNT_ID=act_your-ad-account-id

# Meta Business Manager (for social media posting)
META_BUSINESS_MANAGER_ID=your-business-manager-id
# Prefer a Business Manager system user token. If empty, META_ACCESS_TOKEN (above) is used for Graph API calls.
META_SYSTEM_USER_TOKEN=your-system-user-token

# ================================
# Google Ads Configuration
# ================================
# Required for Google Ads campaigns
GOOGLE_ADS_CLIENT_ID=your-google-ads-client-id
GOOGLE_ADS_CLIENT_SECRET=your-google-ads-client-secret
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
GOOGLE_ADS_CUSTOMER_ID=your-customer-id

# ================================
# Application URL (for OAuth callbacks)
# ================================
APP_URL=http://localhost:3000

# ================================
# Stripe Payment Configuration
# ================================
# Required for credit card payments (campaign funding)
# Get these from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY: backend (apps/backend) — campaign funding PaymentIntents, Stripe customer
# VITE_STRIPE_PUBLISHABLE_KEY: company app — Stripe.js Payment Element (create / fund campaign)
# Company Vite loads VITE_* from this repo root (see apps/company/vite.config.ts envDir)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# ================================
# WhatsApp Business API (Cloud API) - Messaging broadcasts
# ================================
# Optional. When set with recipientPhoneNumbers on a broadcast, messages are sent via Meta.
# Get from https://developers.facebook.com/docs/whatsapp/cloud-api
# META_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# META_WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# ================================
# Twilio SMS - Messaging broadcasts
# ================================
# Optional. When set with recipientPhoneNumbers on a broadcast, SMS are sent via Twilio.
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890