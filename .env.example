# ================================
# RESMO MONOREPO - ENV EXAMPLE
# ================================
# Copy this file to .env and fill in your values
# NEVER commit .env with real secrets

# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/resmo

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=*

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Configuration (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Frontend URLs
VITE_API_URL=http://localhost:3000
VITE_ADMIN_URL=http://localhost:5173
VITE_COMPANY_URL=http://localhost:5174
VITE_SUPERADMIN_URL=http://localhost:5175
VITE_CONSEILLER_URL=http://localhost:5176
