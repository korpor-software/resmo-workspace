# ================================
# RESMO WORKSPACE .gitignore
# ================================

# Apps folder (each app has its own repo)
apps/

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment files (NEVER commit secrets)
.env
.env.local
.env.*.local

# Build outputs
dist/
build/
.next/
out/

# Bun
bun.lockb

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Cursor (keep rules, ignore cache)
!.cursor/rules/
.cursor/mcp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/

# Temp files
*.tmp
*.temp
.cache/

# OS files
Thumbs.db
